modules = ["python-3.11", "nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql", "xcodebuild", "zlib"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21607
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Collector"

[[workflows.workflow]]
name = "Collector"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m collector.app.standalone"

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

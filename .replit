modules = ["python-3.11", "nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql", "xcodebuild", "zlib"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 21607
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Collector"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Collector"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m collector.app.standalone"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BASE_PATH=/ PORT=21607 API_PORT=8080 pnpm --filter @workspace/licitaim run dev"
waitForPort = 21607

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 PYTHONPATH=/home/runner/workspace/.pythonlibs/lib/python3.11/site-packages uvicorn app.main:app --host 0.0.0.0 --port 8080 --app-dir artifacts/api-server"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
